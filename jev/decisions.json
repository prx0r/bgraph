{
  "schema_version": "bgraph-jev-decisions.v1",
  "model_pin": "stub-local-v1",
  "law": "Thresholds couple to decision_id. Never carry a Noul threshold onto a Choice. Fail-closed on money/publish.",
  "bands": {
    "auto": 0.8,
    "confirm": 0.5
  },
  "decisions": [
    {
      "id": "brand_ready",
      "question": "Is this store ready for catalog push consideration?",
      "primitive": "noul",
      "scope": "store",
      "fail_direction": "human",
      "inputs": ["pack_count", "has_store_json", "has_domain", "commerce_link_ok"],
      "thresholds": { "auto": 0.8, "confirm": 0.5 },
      "action_if_true": "allow_shopify_push_consideration",
      "action_if_false": "hold_until_ready"
    },
    {
      "id": "shopify_push_ok",
      "question": "Should we push listing drafts to Shopify for this store?",
      "primitive": "noul",
      "scope": "store",
      "fail_direction": "fail_closed_human",
      "inputs": ["brand_ready", "pack_count", "currency_policy"],
      "thresholds": { "auto": 0.9, "confirm": 0.7 },
      "action_if_true": "recommend_human_push",
      "action_if_false": "hold_no_push"
    },
    {
      "id": "next_photo_sku",
      "question": "Which SKU should get images next for this store?",
      "primitive": "choice",
      "scope": "store",
      "options": ["top_priority_pack", "best_margin_hint", "featured_section"],
      "fail_direction": "score_order",
      "inputs": ["pack_count", "sections", "priority"],
      "thresholds": { "auto": 0.8, "confirm": 0.5 }
    },
    {
      "id": "content_tree_ok",
      "question": "Does this store have a defined content/R2 layout contract?",
      "primitive": "noul",
      "scope": "store",
      "fail_direction": "human",
      "inputs": ["has_bgraph_branches", "r2_prefix_set"],
      "thresholds": { "auto": 0.85, "confirm": 0.5 },
      "action_if_true": "content_engine_can_target_store",
      "action_if_false": "define_r2_layout_first"
    }
  ]
}
